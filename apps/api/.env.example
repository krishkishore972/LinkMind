# Copy this file to apps/api/.env and replace placeholders as needed.
# The default DATABASE_URL below matches the local database in docker-compose.yml.
DATABASE_URL="postgresql://linkmind:linkmind_local_dev@localhost:5432/linkmind?schema=public"
PORT=4000
# Allowed browser origin for CORS (the web app dev server).
FRONTEND_ORIGIN="http://localhost:3000"

# Optional. Only needed for embedding/LLM-backed features that are not yet part
# of the MVP. BM25 retrieval, evaluation metrics, and the test suite must not
# require these values.
EMBEDDING_PROVIDER="gemini"
GEMINI_API_KEY=""
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSIONS="3072"

# Chat provider. Use `groq` for the OpenAI-compatible Groq API or `fake` for offline tests.
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""
