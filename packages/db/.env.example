# Copy this file to `.env`.
# The default below matches the local database in docker-compose.yml (pgvector/pgvector:pg16).
# Requires PostgreSQL >= 15 with the pgvector extension.
DATABASE_URL="postgresql://linkmind:linkmind_local_dev@localhost:5432/linkmind?schema=public"

# To use a remote database instead, replace the URL above with a connection
# string for any PostgreSQL 15+ server that has the pgvector extension available.
